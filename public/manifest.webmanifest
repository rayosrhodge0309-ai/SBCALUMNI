{
  "name": "Alumni Link",
  "short_name": "Alumni Link",
  "description": "A phone-friendly alumni portal for records, announcements, events, and school updates.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone"],
  "background_color": "#f8fbff",
  "theme_color": "#0d6efd",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/images/pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/images/pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Alumni Portal",
      "short_name": "Portal Login",
      "url": "/portal/login",
      "description": "Sign in to request school records and view updates."
    },
    {
      "name": "Register Account",
      "short_name": "Register",
      "url": "/portal/register",
      "description": "Claim your alumni account on a phone."
    }
  ]
}
