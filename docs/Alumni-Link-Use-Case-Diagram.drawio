        <mxCell id="descriptionTitle" value="Diagram Description" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="60" y="845" width="1480" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="descriptionText" value="This use case diagram presents the main interactions between the users and the Alumni Link System. A visitor can browse published updates and create an account. An approved alumni user can sign in, manage a profile, submit record requests, register for events, and view statuses or notifications. The administrator manages alumni accounts and records, maintains school levels and academic programs, publishes events and updates, and processes submitted requests and event registrations." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#334155;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="880" width="1480" height="110" as="geometry"/>
        </mxCell>
