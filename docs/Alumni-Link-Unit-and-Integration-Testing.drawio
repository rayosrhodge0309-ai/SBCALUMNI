        <mxCell id="uDescriptionText" value="This section presents module-level tests for the current Alumni Link System. It checks registration and login rules, Gmail and academic program validation, OTP verification, password reset, administrator program management, and event registration validation. A Passed result means the tested module produced the expected response and database state." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#334155;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="1319" width="1480" height="78" as="geometry"/></mxCell>
