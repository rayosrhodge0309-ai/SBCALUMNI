<mxCell id="o_catalog_note" value="Catalog relationship" style="swimlane;horizontal=1;startSize=36;collapsible=0;html=0;fillColor=#E2E8F0;swimlaneFillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#334155;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="360" height="145" as="geometry"/></mxCell>
<mxCell id="o_catalog_note_body" value="Alumni stores course and education level as text.&#xa;There is no database foreign key to academic_programs." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#475569;verticalAlign=top;" vertex="1" parent="o_catalog_note"><mxGeometry x="14" y="48" width="332" height="87" as="geometry"/></mxCell>
<mxCell id="o_legend" value="Reading this ERD" style="swimlane;horizontal=1;startSize=36;collapsible=0;html=0;fillColor=#E2E8F0;swimlaneFillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#334155;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1650" y="1120" width="360" height="205" as="geometry"/></mxCell>
<mxCell id="o_legend_body" value="PK: primary key   FK: foreign key&#xa;UK: unique key   ?: nullable&#xa;1 = exactly one   0..1 = optional one&#xa;0..* = zero or many&#xa;Solid lines: database foreign keys&#xa;Dashed line: polymorphic notification link" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#475569;verticalAlign=top;" vertex="1" parent="o_legend"><mxGeometry x="14" y="48" width="332" height="147" as="geometry"/></mxCell>
