<mxCell id="d_constraint_notes" value="Constraints and implementation notes" style="swimlane;horizontal=1;startSize=36;collapsible=0;html=0;fillColor=#E2E8F0;swimlaneFillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#334155;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1790" y="1370" width="520" height="280" as="geometry"/></mxCell>
<mxCell id="d_constraint_notes_body" value="PK = primary key; FK = foreign key; UK = unique key.&#xa;&#xa;alumni.student_id and alumni.email are not unique at the database level.&#xa;&#xa;Notifications uses notifiable_type + notifiable_id to identify its target; these are not database foreign keys.&#xa;&#xa;The alumni import migration makes six fields nullable in MySQL and skips SQLite." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#475569;verticalAlign=top;" vertex="1" parent="d_constraint_notes"><mxGeometry x="14" y="48" width="492" height="222" as="geometry"/></mxCell>
<mxCell id="d_delete_notes" value="Deletion behavior" style="swimlane;horizontal=1;startSize=36;collapsible=0;html=0;fillColor=#E2E8F0;swimlaneFillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#334155;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="50" y="1810" width="2260" height="110" as="geometry"/></mxCell>
<mxCell id="d_delete_notes_body" value="Deleting alumni cascades to requests and event registrations; users.alumni_id is set to NULL. Deleting an event cascades to its registrations. Deleting a request cascades to its status history. Foreign keys pointing to users are set to NULL on user deletion." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#475569;verticalAlign=top;" vertex="1" parent="d_delete_notes"><mxGeometry x="14" y="48" width="2232" height="52" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
</mxfile>
