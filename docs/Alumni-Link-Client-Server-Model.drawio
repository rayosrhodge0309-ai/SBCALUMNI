        <mxCell id="descriptionTitle" value="Diagram Description" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="1480" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="descriptionText" value="This client–server model shows how users access the Alumni Link System through a web browser. Visitors view public information, alumni use portal services, and administrators manage system records and transactions. Each client sends HTTPS requests to the Laravel application server, which performs authentication, account verification, data management, request processing, content publishing, and notification handling. The server reads and writes information in the application database, stores uploaded files and media, sends OTP or email messages through Gmail/SMTP, and sends push notifications through Firebase Cloud Messaging. The server returns the requested pages, data, and status updates to the appropriate client." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#334155;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="825" width="1480" height="150" as="geometry"/>
        </mxCell>
