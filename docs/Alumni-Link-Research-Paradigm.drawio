  <diagram id="alumni-link-research-paradigm" name="Research Paradigm">
    <mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Research Paradigm of the Alumni Link System" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1320" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Input – Process – Output Model" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1320" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="inputPanel" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="360" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="inputHeader" value="INPUT" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontFamily=Arial;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="320" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="inputContent" value="• Alumni personal information&#xa;&#xa;• School level, program, and course&#xa;&#xa;• Existing alumni records&#xa;&#xa;• Requests, registrations, and content" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;fontColor=#1E293B;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=20;spacingTop=18;" vertex="1" parent="1">
          <mxGeometry x="80" y="235" width="320" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="processPanel" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#818CF8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="140" width="360" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="processHeader" value="PROCESS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#4338CA;strokeColor=#4338CA;fontColor=#FFFFFF;fontFamily=Arial;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="160" width="320" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="processContent" value="• Register, verify, and approve accounts&#xa;&#xa;• Manage alumni and academic data&#xa;&#xa;• Process requests and registrations&#xa;&#xa;• Publish updates and send notifications" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontColor=#1E293B;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=20;spacingTop=18;" vertex="1" parent="1">
          <mxGeometry x="540" y="235" width="320" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="outputPanel" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#4ADE80;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="980" y="140" width="360" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="outputHeader" value="OUTPUT" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#15803D;strokeColor=#15803D;fontColor=#FFFFFF;fontFamily=Arial;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1000" y="160" width="320" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="outputContent" value="• Verified and organized alumni records&#xa;&#xa;• Accessible alumni portal and updates&#xa;&#xa;• Tracked requests and event registrations&#xa;&#xa;• Improved alumni–administrator communication" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBF7D0;fontColor=#1E293B;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=20;spacingTop=18;" vertex="1" parent="1">
          <mxGeometry x="1000" y="235" width="320" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="feedbackBox" value="FEEDBACK&#xa;Alumni and administrator feedback guides system improvements." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FB923C;strokeWidth=2;fontColor=#7C2D12;fontFamily=Arial;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="455" y="545" width="490" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="arrowInputProcess" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="inputPanel" target="processPanel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrowProcessOutput" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="processPanel" target="outputPanel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrowOutputFeedback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#EA580C;strokeWidth=2;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="outputPanel" target="feedbackBox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrowFeedbackInput" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=2;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="feedbackBox" target="inputPanel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="descriptionTitle" value="Diagram Description" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="1280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="descriptionText" value="This research paradigm uses the Input–Process–Output model. The inputs are alumni information, academic data, existing records, service requests, event registrations, and published content. The system processes these inputs through account verification, data management, request handling, content publishing, and notifications. The outputs are organized alumni records, an accessible portal, tracked transactions, and improved communication. Feedback from alumni and administrators guides future system improvements." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#334155;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="695" width="1280" height="110" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
