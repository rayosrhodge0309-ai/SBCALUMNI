        <mxCell id="descriptionTitle" value="Diagram Description" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="60" y="905" width="1880" height="30" as="geometry"/></mxCell>
        <mxCell id="descriptionText" value="This workflow shows the main journey through the Alumni Link System. A visitor opens the landing page, registers or signs in, and the system checks the account status. Pending accounts are reviewed by the administrator, while approved alumni verify a Gmail OTP before entering the portal. Alumni can submit record requests or register for events. The administrator processes each submission, and the system saves the updated status and sends a notification. The administrator also maintains alumni records, academic programs, users, and published content." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#334155;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="940" width="1880" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
